{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/shop",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/shop.html",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/checkout",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/checkout.html",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/success",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/success.html",
      "destination": "/products",
      "permanent": true
    }
  ]
}
